{
  "name": "python-to-typescript-bridge-book",
  "private": true,
  "version": "0.0.0",
  "description": "Executable examples and validation for Python to TypeScript",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.7.0 <12.0.0"
  },
  "scripts": {
    "build:examples": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "pnpm run build:examples && node --test dist/tests/smoke.test.js",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}

